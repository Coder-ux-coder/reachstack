{
  "name": "@reachstack/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/scripts/seed-demo.ts",
    "routes:audit": "tsx src/scripts/route-audit.ts",
    "owner": "tsx --env-file-if-exists=../../.env src/scripts/owner.ts",
    "api-key": "tsx --env-file-if-exists=../../.env src/scripts/api-key.ts",
    "restore": "tsx --env-file-if-exists=../../.env src/scripts/restore.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@libsql/client": "^0.18.0",
    "@reachstack/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "imapflow": "^1.7.8",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.38",
    "nodemailer": "^7.0.13",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
