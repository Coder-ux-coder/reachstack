# Copy to .env and adjust. Everything is optional for local use.

# Branding
BRAND_NAME=Reachstack

# Privacy center (/privacy/info): how people reach whoever runs this installation, and links to your
# own privacy policy and terms. Each is optional; empty ones are left off the pages.
PRIVACY_EMAIL=
PRIVACY_PHONE=
PRIVACY_POLICY_URL=
TERMS_URL=

# Where the app is reachable (used in links, tracking pixels, OAuth redirects)
APP_URL=http://localhost:4000
PORT=4000
# Which network the server listens on: 0.0.0.0 for every network (a server others reach), localhost for this
# computer only. `npm run local` uses localhost unless this is set.
HOST=
# Where the browser app lives, for links in emails and redirects (defaults to APP_URL).
# While developing the UI with `npm run dev`, set it to the Vite URL: http://localhost:5173
WEB_URL=

# Directory for the SQLite database and generated secrets (default ./data)
DATA_DIR=./data

# 32+ char secret for sessions/encryption. Generated into DATA_DIR/secret.key when empty.
APP_SECRET=

# Domain used for open/click tracking links (defaults to APP_URL host).
TRACKING_BASE_URL=

# System mail (password resets, invites, verification). Leave empty to log mails to the console.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
SYSTEM_SMTP_FROM=

# Google OAuth app (connect Gmail / Google Workspace accounts, Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth app (connect Outlook / Microsoft 365 accounts)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Anthropic API key for agents, copilot, AI replies, reply labelling and AI enrichment.
# Without a key these features fall back to rules (labelling) or stay switched off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Development only: send AI calls to the local stand-in instead of the real API (see tools/dev/README.md).
# ANTHROPIC_BASE_URL=http://localhost:4999

# Or a free local AI through an OpenAI-compatible server (Ollama, LM Studio, vLLM). Copilot needs a model with tool calls.
# AI_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen3:14b
# OPENAI_API_KEY=
# The installation owner can also set all of this in Settings → Installation → Services.

# Stripe billing (leave empty: self-hosted mode, all plans unlimited)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe Connect OAuth client ID, so CRM reports can connect a workspace's own Stripe account
# for "cash collected" (without it, workspaces paste a restricted key instead).
STRIPE_CONNECT_CLIENT_ID=

# Twilio for CRM calls & SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Website visitor company identification (ipinfo.io token). Workspace admins can also save their own token in the app.
IPINFO_TOKEN=
# IP lookup API base URL. Development only: http://localhost:4998 for the local stand-in (token "test-ipinfo").
IPINFO_BASE_URL=https://ipinfo.io
# Optional: email-finder fallback (hunter.io) for people outside the Lead Finder dataset.
HUNTER_API_KEY=

# Deliverability tools
# Public DNS resolvers to retry record lookups on when the system resolver fails (empty disables).
DNS_FALLBACK_SERVERS=1.1.1.1,8.8.8.8
# Probe recipient mail servers over SMTP (port 25) during email verification. Most cloud hosts block port 25.
VERIFY_SMTP_PROBE=false
# SpamAssassin daemon (spamd) for content scoring. Leave empty to use the built-in heuristic.
SPAMD_HOST=
SPAMD_PORT=783
# Allow webhooks to private/loopback addresses (defaults to true outside production).
ALLOW_PRIVATE_URLS=
# Which reverse proxies may pass on the visitor's address (X-Forwarded-For). Default: one on this machine or on a
# private network ("loopback,uniquelocal"). Use "false" when the server faces the internet directly, a hop count
# ("1") or proxy addresses otherwise. Rate limits and website-visitor lookups rely on the right address.
TRUST_PROXY=

# Set to "false" to run the background engine in a separate process (npm run worker). Two servers or workers on the
# same data never both run it: the second one stands by and takes over if the first stops.
RUN_WORKER_IN_PROCESS=true

# Set (to any value) when something starts the server again after it exits, such as systemd, Docker or pm2 with a
# restart policy: Settings → Installation then offers "Restart now". npm run local sets it by itself.
REACHSTACK_SUPERVISOR=

# Server log level (fatal, error, warn, info, debug). NODE_ENV=production hides internal error messages
# and blocks webhooks to private addresses unless ALLOW_PRIVATE_URLS=true.
LOG_LEVEL=warn
